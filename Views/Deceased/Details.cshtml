@model Deceased
@{
    ViewData["Title"] = Model.FullName;
    ViewData["Nav"] = "deceased";
    var requests = (List<RequestListItem>)ViewData["Requests"]!;
}
<div class="breadcrumb"><a asp-action="Index">Deceased records</a> @Html.Icon("chevron-right", "icon-sm") <span>@Model.FullName</span></div>
<div class="page-header">
    <div><h1>@Model.FullName</h1><p>Record added @Ph.Date(Model.CreatedAt)</p></div>
    <div class="actions">
        <a class="btn btn-secondary" asp-action="Edit" asp-route-id="@Model.DeceasedID">@Html.Icon("pencil") Edit</a>
        <a class="btn btn-primary" asp-controller="Requests" asp-action="New" asp-route-deceasedId="@Model.DeceasedID">@Html.Icon("plus") New request</a>
    </div>
</div>

<div class="split">
    <div class="card">
        <div class="card-header"><h3>@Html.Icon("files") Document requests</h3></div>
        @if (requests.Count == 0)
        {
            <div class="empty"><span class="empty-icon">@Html.Icon("file-plus", "icon-lg")</span><h3>No requests yet</h3><p>Start a request to submit the documents needed for this record.</p>
            <a class="btn btn-primary" asp-controller="Requests" asp-action="New" asp-route-deceasedId="@Model.DeceasedID">Start a request</a></div>
        }
        else
        {
            <div class="card-body flush table-wrap">
                <table class="table responsive">
                    <thead><tr><th>Reference</th><th>Request</th><th>Filed</th><th>Status</th></tr></thead>
                    <tbody>
                    @foreach (var r in requests)
                    {
                        <tr>
                            <td class="cell-main" data-label="Reference"><a class="cell-title" asp-controller="Requests" asp-action="Details" asp-route-id="@r.RequestID">@r.ReferenceNumber</a></td>
                            <td data-label="Request">@r.TypeName</td>
                            <td data-label="Filed" class="nowrap">@Ph.Date(r.DateFiled)</td>
                            <td data-label="Status">@Html.StatusBadge(r.StatusName)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="card">
        <div class="card-header"><h3>@Html.Icon("info") Details</h3></div>
        <div class="card-body">
            <dl class="kv">
                <dt>Date of birth</dt><dd>@Ph.Date(Model.DateOfBirth)</dd>
                <dt>Date of death</dt><dd>@Ph.Date(Model.DateOfDeath)</dd>
                <dt>Place of death</dt><dd>@(Model.PlaceOfDeath ?? "-")</dd>
                <dt>Cause of death</dt><dd>@(Model.CauseOfDeath ?? "-")</dd>
                <dt>Your relationship</dt><dd>@(Model.Relationship ?? "-")</dd>
            </dl>
        </div>
    </div>
</div>
