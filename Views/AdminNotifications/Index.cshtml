@model PagedResult<AdminNotificationRow>
@{
    ViewData["Title"] = "Notifications"; ViewData["Nav"] = "notifications";
    var q = ViewData["Query"] as string; var state = ViewData["State"] as string;
}
<div class="page-header">
    <div><h1>Notifications</h1><p>Every notification sent to families, including those generated automatically by request activity.</p></div>
    <div class="actions"><a class="btn btn-primary" asp-action="Send">@Html.Icon("send") Send notification</a></div>
</div>
<div class="card">
    <form method="get" class="toolbar">
        <div class="field grow"><label class="label" for="q">Search</label><div class="search-input">@Html.Icon("search")<input id="q" name="q" value="@q" class="input" placeholder="Recipient, title or message" /></div></div>
        <div class="field"><label class="label" for="state">State</label><select id="state" name="state" class="select"><option value="">All</option><option value="unread" selected="@(state == "unread")">Unread</option><option value="read" selected="@(state == "read")">Read</option></select></div>
        <button class="btn btn-secondary" type="submit">Filter</button>
        @if (!string.IsNullOrEmpty(q) || !string.IsNullOrEmpty(state)) { <a class="btn btn-ghost" asp-action="Index">Clear</a> }
    </form>
    @if (Model.Total == 0) { <div class="empty"><span class="empty-icon">@Html.Icon("bell", "icon-lg")</span><h3>No notifications found</h3><p>Notifications are created when families submit requests and when staff update them.</p></div> }
    else
    {
        <div class="table-wrap"><table class="table responsive"><thead><tr><th>Recipient</th><th>Notification</th><th>Request</th><th>Sent</th><th>State</th></tr></thead><tbody>
        @foreach (var n in Model.Items)
        {
            <tr><td class="cell-main" data-label="Recipient"><span class="cell-title">@n.RecipientName</span></td>
            <td data-label="Notification"><div class="cell-title">@n.Title</div><div class="cell-sub" style="max-width:46ch">@n.Message</div></td>
            <td data-label="Request">@if (n.RequestID.HasValue) { <a asp-controller="AdminRequests" asp-action="Details" asp-route-id="@n.RequestID">@n.Reference</a> } else { <span class="muted">-</span> }</td>
            <td data-label="Sent" class="nowrap">@Ph.DateTimeText(n.CreatedAt)</td>
            <td data-label="State">@if (n.IsRead) { <span class="badge badge-muted">Read</span> } else { <span class="badge badge-submitted">Unread</span> }</td></tr>
        }</tbody></table></div>
        <partial name="_Pager" model="Model" />
    }
</div>
