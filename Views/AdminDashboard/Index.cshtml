@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
    ViewData["Nav"] = "dashboard";
    var totalStatus = Model.StatusDistribution.Sum(s => s.Count);
    var maxCat = Math.Max(1, Model.CategoryDistribution.Max(c => (int?)c.Count) ?? 1);
}
<div class="page-header">
    <div><h1>Dashboard</h1><p>An overview of families, requests and funeral homes across KABILIN.</p></div>
    <div class="actions"><a class="btn btn-primary" asp-controller="AdminRequests" asp-action="Index">@Html.Icon("file-text") Manage requests</a></div>
</div>

@if (Model.Overdue > 0)
{
    <div class="alert alert-warning mb-16">@Html.Icon("triangle-alert")<div><strong>@Model.Overdue request@(Model.Overdue == 1 ? " is" : "s are") past the estimated completion date.</strong>
        <a asp-controller="AdminRequests" asp-action="Index" asp-route-overdue="true">Review overdue requests</a></div></div>
}

<div class="grid grid-4 mb-16">
    <a class="card stat" asp-controller="AdminUsers" asp-action="Index"><span class="stat-icon">@Html.Icon("users")</span><span><div class="stat-value">@Model.FamilyRepresentatives</div><div class="stat-label">Family representatives</div></span></a>
    <a class="card stat" asp-controller="AdminDeceased" asp-action="Index"><span class="stat-icon">@Html.Icon("book-user")</span><span><div class="stat-value">@Model.DeceasedRecords</div><div class="stat-label">Deceased records</div></span></a>
    <a class="card stat" asp-controller="AdminRequests" asp-action="Index"><span class="stat-icon">@Html.Icon("files")</span><span><div class="stat-value">@Model.TotalRequests</div><div class="stat-label">Document requests</div></span></a>
    <a class="card stat" asp-controller="AdminFuneralHomes" asp-action="Index"><span class="stat-icon">@Html.Icon("building-2")</span><span><div class="stat-value">@Model.FuneralHomes</div><div class="stat-label">Funeral homes</div></span></a>
</div>

<div class="grid grid-6 mb-16">
    <a class="card stat" asp-controller="AdminRequests" asp-action="Index" asp-route-status="1"><span><div class="stat-value">@Model.Pending</div><div class="stat-label">Pending</div></span></a>
    <a class="card stat" asp-controller="AdminRequests" asp-action="Index" asp-route-status="4"><span><div class="stat-value">@Model.UnderReview</div><div class="stat-label">Under review</div></span></a>
    <a class="card stat" asp-controller="AdminRequests" asp-action="Index" asp-route-status="5"><span><div class="stat-value">@Model.Incomplete</div><div class="stat-label">Incomplete</div></span></a>
    <a class="card stat" asp-controller="AdminRequests" asp-action="Index" asp-route-status="2"><span><div class="stat-value">@Model.Processing</div><div class="stat-label">Processing</div></span></a>
    <a class="card stat" asp-controller="AdminRequests" asp-action="Index" asp-route-status="3"><span><div class="stat-value">@Model.Completed</div><div class="stat-label">Completed</div></span></a>
    <a class="card stat" asp-controller="AdminRequests" asp-action="Index" asp-route-status="7"><span><div class="stat-value">@Model.Rejected</div><div class="stat-label">Rejected</div></span></a>
</div>

<div class="grid grid-2 mb-16">
    <div class="card">
        <div class="card-header"><h3>@Html.Icon("chart-pie") Requests by status</h3></div>
        <div class="card-body">
            @if (totalStatus == 0) { <p class="muted">No requests have been submitted yet.</p> }
            else
            {
                <div class="donut-wrap">
                    <svg class="donut" viewBox="0 0 42 42" role="img" aria-label="Request status distribution">
                        <circle cx="21" cy="21" r="15.9155" fill="none" stroke="#EFF2E9" stroke-width="6"></circle>
                        @{ double offset = 25; }
                        @foreach (var s in Model.StatusDistribution.Where(x => x.Count > 0))
                        {
                            var pct = s.Count * 100.0 / totalStatus;
                            <circle cx="21" cy="21" r="15.9155" fill="none" stroke="@s.Color" stroke-width="6"
                                    stroke-dasharray="@pct.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture) @((100 - pct).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture))"
                                    stroke-dashoffset="@offset.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)"></circle>
                            offset -= pct;
                        }
                        <text x="21" y="22.5" text-anchor="middle" font-size="7" font-weight="600">@totalStatus</text>
                        <text x="21" y="27" text-anchor="middle" font-size="2.6" fill="#66756D" style="fill:#66756D">requests</text>
                    </svg>
                    <ul class="legend">
                        @foreach (var s in Model.StatusDistribution)
                        {
                            <li><span class="swatch" style="background:@s.Color"></span>@s.Label<span class="count">@s.Count</span></li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>
    <div class="card">
        <div class="card-header"><h3>@Html.Icon("chart-bar") Requests by category</h3></div>
        <div class="card-body">
            @if (Model.TotalRequests == 0) { <p class="muted">No requests have been submitted yet.</p> }
            else
            {
                <div class="bars">
                    @foreach (var c in Model.CategoryDistribution)
                    {
                        <div>
                            <div class="bar-label"><span>@c.Label</span><strong>@c.Count</strong></div>
                            <div class="bar-track"><div class="bar-fill" style="width:@((c.Count * 100 / maxCat))%"></div></div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<div class="split">
    <div class="card">
        <div class="card-header"><h3>@Html.Icon("files") Recent requests</h3><a class="support" asp-controller="AdminRequests" asp-action="Index">View all</a></div>
        @if (Model.RecentRequests.Count == 0)
        {
            <div class="empty"><span class="empty-icon">@Html.Icon("files", "icon-lg")</span><h3>No requests yet</h3><p>Requests submitted by families will appear here.</p></div>
        }
        else
        {
            <div class="card-body flush table-wrap">
                <table class="table responsive">
                    <thead><tr><th>Reference</th><th>Family</th><th>Request</th><th>Status</th></tr></thead>
                    <tbody>
                    @foreach (var r in Model.RecentRequests)
                    {
                        <tr>
                            <td class="cell-main" data-label="Reference"><a class="cell-title" asp-controller="AdminRequests" asp-action="Details" asp-route-id="@r.RequestID">@r.ReferenceNumber</a></td>
                            <td data-label="Family">@r.FamilyName</td>
                            <td data-label="Request"><span class="cell-stack"><div>@r.TypeName</div><div class="cell-sub">@r.DeceasedName</div></span></td>
                            <td data-label="Status">@Html.StatusBadge(r.StatusName)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
    <div class="card">
        <div class="card-header"><h3>@Html.Icon("history") Recent activity</h3><a class="support" asp-controller="AdminActivity" asp-action="Index">View all</a></div>
        <div class="card-body">
            @if (Model.RecentActivities.Count == 0) { <p class="muted">No activity recorded yet.</p> }
            else
            {
                <ul class="timeline">
                @foreach (var a in Model.RecentActivities)
                {
                    <li><span class="pip"></span><div class="t-title">@a.Action</div>
                        <div class="t-meta">@a.UserName &middot; @Ph.Ago(a.CreatedAt)</div>
                        <div class="t-text">@a.Description</div></li>
                }
                </ul>
            }
        </div>
    </div>
</div>
