@model PagedResult<AdminRequestRow>
@{
    ViewData["Title"] = "Document Requests"; ViewData["Nav"] = "requests";
    var f = (AdminRequestFilter)ViewData["Filter"]!;
    var statuses = (List<Status>)ViewData["Statuses"]!;
    var types = (List<RequestType>)ViewData["Types"]!;
    var filtered = !string.IsNullOrEmpty(f.Q) || f.Status.HasValue || f.Type.HasValue || f.From.HasValue || f.To.HasValue || f.Overdue;
}
<div class="page-header"><div><h1>Document requests</h1><p>Review submitted requirements, update statuses and manage timelines.</p></div></div>
<div class="card">
    <form method="get" class="toolbar">
        <div class="field grow"><label class="label" for="q">Search</label><div class="search-input">@Html.Icon("search")<input id="q" name="q" value="@f.Q" class="input" placeholder="Reference, family or deceased name" /></div></div>
        <div class="field"><label class="label" for="status">Status</label><select id="status" name="status" class="select"><option value="">All statuses</option>
            @foreach (var id in StatusIds.DisplayOrder) { var s = statuses.First(x => x.StatusID == id); <option value="@s.StatusID" selected="@(f.Status == s.StatusID)">@s.StatusName</option> }</select></div>
        <div class="field"><label class="label" for="type">Category</label><select id="type" name="type" class="select"><option value="">All categories</option>
            @foreach (var t in types) { <option value="@t.TypeID" selected="@(f.Type == t.TypeID)">@t.TypeName</option> }</select></div>
        <div class="field"><label class="label" for="from">From</label><input id="from" name="from" type="date" class="input" value="@f.From?.ToString("yyyy-MM-dd")" /></div>
        <div class="field"><label class="label" for="to">To</label><input id="to" name="to" type="date" class="input" value="@f.To?.ToString("yyyy-MM-dd")" /></div>
        <label class="check" style="padding-bottom:10px"><input type="checkbox" name="overdue" value="true" checked="@f.Overdue" /><span>Overdue only</span></label>
        <button class="btn btn-secondary" type="submit">Filter</button>
        @if (filtered) { <a class="btn btn-ghost" asp-action="Index">Clear</a> }
    </form>
    @if (Model.Total == 0)
    {
        <div class="empty"><span class="empty-icon">@Html.Icon("files", "icon-lg")</span><h3>@(filtered ? "No matching requests" : "No requests yet")</h3><p>@(filtered ? "Try changing or clearing the filters." : "Requests submitted by families will appear here.")</p></div>
    }
    else
    {
        <div class="table-wrap"><table class="table responsive">
            <thead><tr><th>Reference</th><th>Family</th><th>Deceased</th><th>Type</th><th>Submitted</th><th>Status</th><th>Estimated</th><th></th></tr></thead>
            <tbody>
            @foreach (var r in Model.Items)
            {
                <tr>
                    <td class="cell-main" data-label="Reference"><a class="cell-title" asp-action="Details" asp-route-id="@r.RequestID">@r.ReferenceNumber</a></td>
                    <td data-label="Family">@r.FamilyName</td>
                    <td data-label="Deceased">@r.DeceasedName</td>
                    <td data-label="Type">@r.TypeName</td>
                    <td data-label="Submitted" class="nowrap">@Ph.Date(r.DateFiled)</td>
                    <td data-label="Status">@Html.StatusBadge(r.StatusName)</td>
                    <td data-label="Estimated" class="nowrap">@Ph.Date(r.EstimatedCompletionDate) @if (r.IsOverdue) { <span class="badge badge-overdue">Overdue</span> }</td>
                    <td class="cell-actions"><div class="actions"><a class="btn btn-secondary btn-sm" asp-action="Details" asp-route-id="@r.RequestID">Open</a></div></td>
                </tr>
            }
            </tbody></table></div>
        <partial name="_Pager" model="Model" />
    }
</div>
