@model List<FuneralHome>
@{
    ViewData["Title"] = "Funeral Homes"; ViewData["Nav"] = "funeral";
    var q = ViewData["Query"] as string; var st = ViewData["StatusFilter"] as string;
}
<div class="page-header">
    <div><h1>Funeral homes</h1><p>Changes appear in the Family Portal and on the map immediately.</p></div>
    <div class="actions"><a class="btn btn-primary" asp-action="Create">@Html.Icon("plus") Add funeral home</a></div>
</div>
<div class="card">
    <form method="get" class="toolbar">
        <div class="field grow"><label class="label" for="q">Search</label><div class="search-input">@Html.Icon("search")<input id="q" name="q" value="@q" class="input" placeholder="Name or address" /></div></div>
        <div class="field"><label class="label" for="status">Listing</label><select id="status" name="status" class="select"><option value="">All</option><option value="active" selected="@(st == "active")">Active</option><option value="archived" selected="@(st == "archived")">Archived</option></select></div>
        <button class="btn btn-secondary" type="submit">Filter</button>
        @if (!string.IsNullOrEmpty(q) || !string.IsNullOrEmpty(st)) { <a class="btn btn-ghost" asp-action="Index">Clear</a> }
    </form>
    @if (Model.Count == 0)
    {
        <div class="empty"><span class="empty-icon">@Html.Icon("building-2", "icon-lg")</span><h3>No funeral homes found</h3><p>Add funeral homes with their address, contact number, services and map coordinates so families can find them.</p>
        <a class="btn btn-primary" asp-action="Create">Add funeral home</a></div>
    }
    else
    {
        <div class="table-wrap"><table class="table responsive"><thead><tr><th>Name</th><th>Contact</th><th>Map</th><th>Listing</th><th></th></tr></thead><tbody>
        @foreach (var h in Model)
        {
            <tr>
                <td class="cell-main" data-label="Name"><a class="cell-title" asp-action="Details" asp-route-id="@h.FuneralID">@h.FuneralName</a><div class="cell-sub">@h.Location</div></td>
                <td data-label="Contact">@h.ContactNum</td>
                <td data-label="Map">@if (h.HasCoordinates) { <span class="badge badge-approved">Located</span> } else { <span class="badge badge-incomplete-requirements">No coordinates</span> }</td>
                <td data-label="Listing">@if (h.IsActive) { <span class="badge badge-approved">Active</span> } else { <span class="badge badge-muted">Archived</span> }</td>
                <td class="cell-actions"><div class="actions">
                    <a class="btn btn-secondary btn-sm" asp-action="Edit" asp-route-id="@h.FuneralID">Edit</a>
                    <form asp-action="SetActive" asp-route-id="@h.FuneralID" asp-route-active="@(!h.IsActive)" method="post">
                        @if (h.IsActive)
                        {
                            <button type="submit" class="btn btn-ghost btn-sm" data-confirm="Families will no longer see this funeral home. You can restore it later." data-confirm-title="Archive funeral home?" data-confirm-button="Archive" data-confirm-danger="false">Archive</button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-ghost btn-sm">Restore</button>
                        }
                    </form>
                    <form asp-action="Delete" asp-route-id="@h.FuneralID" method="post">
                        <button type="submit" class="btn btn-danger btn-sm" data-confirm="This permanently removes &quot;@h.FuneralName&quot;. This cannot be undone." data-confirm-title="Delete funeral home?" data-confirm-button="Delete">Delete</button>
                    </form></div></td>
            </tr>
        }</tbody></table></div>
    }
</div>
