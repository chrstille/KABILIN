@model PagedResult<AdminDeceasedRow>
@{
    ViewData["Title"] = "Deceased Records"; ViewData["Nav"] = "deceased";
    var q = ViewData["Query"] as string; var year = ViewData["Year"] as int?; var has = ViewData["HasRequests"] as bool?;
    var years = (List<int>)ViewData["Years"]!;
}
<div class="page-header"><div><h1>Deceased records</h1><p>Read-only view of the records registered by families.</p></div></div>
<div class="card">
    <form method="get" class="toolbar">
        <div class="field grow"><label class="label" for="q">Search</label><div class="search-input">@Html.Icon("search")<input id="q" name="q" value="@q" class="input" placeholder="Deceased or family name" /></div></div>
        <div class="field"><label class="label" for="year">Year of death</label><select id="year" name="year" class="select"><option value="">All years</option>@foreach (var y in years) { <option value="@y" selected="@(year == y)">@y</option> }</select></div>
        <div class="field"><label class="label" for="hasRequests">Requests</label><select id="hasRequests" name="hasRequests" class="select"><option value="">Any</option><option value="true" selected="@(has == true)">With requests</option><option value="false" selected="@(has == false)">Without requests</option></select></div>
        <button class="btn btn-secondary" type="submit">Filter</button>
        @if (!string.IsNullOrEmpty(q) || year.HasValue || has.HasValue) { <a class="btn btn-ghost" asp-action="Index">Clear</a> }
    </form>
    @if (Model.Total == 0) { <div class="empty"><span class="empty-icon">@Html.Icon("book-user", "icon-lg")</span><h3>No records found</h3><p>Records appear here after families add them.</p></div> }
    else
    {
        <div class="table-wrap"><table class="table responsive"><thead><tr><th>Name</th><th>Date of death</th><th>Place</th><th>Family representative</th><th>Requests</th></tr></thead><tbody>
        @foreach (var d in Model.Items)
        {
            <tr><td class="cell-main" data-label="Name"><a class="cell-title" asp-action="Details" asp-route-id="@d.DeceasedID">@d.FullName</a></td>
            <td data-label="Died" class="nowrap">@Ph.Date(d.DateOfDeath)</td><td data-label="Place">@(d.PlaceOfDeath ?? "-")</td>
            <td data-label="Family"><a asp-controller="AdminUsers" asp-action="Details" asp-route-id="@d.UserID">@d.FamilyName</a></td><td data-label="Requests">@d.RequestCount</td></tr>
        }</tbody></table></div>
        <partial name="_Pager" model="Model" />
    }
</div>
