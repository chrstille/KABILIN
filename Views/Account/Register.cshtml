@model KABILIN.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Create an account";
    ViewData["Wide"] = true;
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <h1>Create your account</h1>
    <p class="lead">Register as a family representative to manage records and document requests in one place.</p>

    <form asp-controller="Account" asp-action="Register" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-error mb-16" role="alert"></div>

        <div class="form-section">
            <h3>Your details</h3>
            <p class="support">Use the name and contact details we should use when updating you.</p>
            <div class="form-grid">
                <div class="field">
                    <label asp-for="FirstName" class="label">First name <span class="req">*</span></label>
                    <input asp-for="FirstName" class="input" autocomplete="given-name" />
                    <span asp-validation-for="FirstName" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="LastName" class="label">Last name <span class="req">*</span></label>
                    <input asp-for="LastName" class="input" autocomplete="family-name" />
                    <span asp-validation-for="LastName" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="MiddleName" class="label">Middle name <span class="opt">(optional)</span></label>
                    <input asp-for="MiddleName" class="input" autocomplete="additional-name" />
                    <span asp-validation-for="MiddleName" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="ContactNum" class="label">Contact number <span class="req">*</span></label>
                    <input asp-for="ContactNum" class="input" type="tel" placeholder="09XX XXX XXXX" autocomplete="tel" />
                    <span asp-validation-for="ContactNum" class="field-error"></span>
                </div>
                <div class="field full">
                    <label asp-for="Address" class="label">Address <span class="req">*</span></label>
                    <input asp-for="Address" class="input" autocomplete="street-address" />
                    <span asp-validation-for="Address" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="City" class="label">City or municipality <span class="req">*</span></label>
                    <input asp-for="City" class="input" autocomplete="address-level2" />
                    <span asp-validation-for="City" class="field-error"></span>
                </div>
            </div>
        </div>

        <div class="form-section">
            <h3>Sign-in details</h3>
            <div class="form-grid">
                <div class="field full">
                    <label asp-for="EmailAddress" class="label">Email address <span class="req">*</span></label>
                    <input asp-for="EmailAddress" class="input" type="email" autocomplete="email" />
                    <span asp-validation-for="EmailAddress" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="Password" class="label">Password <span class="req">*</span></label>
                    <div class="password-wrap">
                        <input asp-for="Password" class="input" type="password" autocomplete="new-password" />
                        <button type="button" class="password-toggle" data-password-toggle aria-label="Show password" aria-pressed="false">@Html.Icon("eye")</button>
                    </div>
                    <span class="hint">At least 8 characters.</span>
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="ConfirmPassword" class="label">Confirm password <span class="req">*</span></label>
                    <input asp-for="ConfirmPassword" class="input" type="password" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                </div>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Create account</button>
            <a class="btn btn-ghost" asp-controller="Account" asp-action="Login">I already have an account</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
