@model KABILIN.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Log in";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <h1>Welcome back</h1>
    <p class="lead">Log in to manage your requests and see their progress.</p>

    <form asp-controller="Account" asp-action="Login" method="post" class="form-stack" novalidate>
        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

        <div asp-validation-summary="ModelOnly" class="alert alert-error" role="alert"></div>

        <div class="field">
            <label asp-for="EmailAddress" class="label">Email address</label>
            <input asp-for="EmailAddress" class="input" type="email" placeholder="you@example.com" autocomplete="email" autofocus />
            <span asp-validation-for="EmailAddress" class="field-error"></span>
        </div>

        <div class="field">
            <label asp-for="Password" class="label">Password</label>
            <div class="password-wrap">
                <input asp-for="Password" class="input" type="password" placeholder="Enter your password" autocomplete="current-password" />
                <button type="button" class="password-toggle" data-password-toggle aria-label="Show password" aria-pressed="false">@Html.Icon("eye")</button>
            </div>
            <span asp-validation-for="Password" class="field-error"></span>
        </div>

        <label class="check">
            <input asp-for="RememberMe" type="checkbox" />
            <span>Keep me signed in on this device</span>
        </label>

        <button type="submit" class="btn btn-primary btn-block">Log in</button>
    </form>

    <p class="auth-footer">
        New to KABILIN? <a asp-controller="Account" asp-action="Register">Create an account</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
