@model KABILIN.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Log In";
    Layout = "_AuthLayout";
}

 @if (TempData["SuccessMessage"] is string successMessage)
{
            <div id="successToast" class="success-toast" role="status">
                @successMessage
            </div>
        }


<!-- LOGIN ERROR NOTIFICATION -->
<div id="loginErrorToast"
     asp-validation-summary="ModelOnly"
     class="login-error-toast"
     role="alert">
</div>


<div class="login-wrapper">

    <!-- =====================================
         RIGHT SIDE - LOGIN FORM
    ====================================== -->

    <div class="glass-card login-card">

        <div class="auth-header">

            <h2>Log In</h2>
            
        </div>

        <form asp-controller="Account"
              asp-action="Login"
              method="post">

            @Html.AntiForgeryToken()

            <!-- EMAIL -->

            <div class="form-group">

                <label asp-for="EmailAddress">
                    Email Address
                </label>

                <input asp-for="EmailAddress"
                       class="glass-input"
                       type="email"
                       placeholder="Enter your email"
                       autocomplete="email" />

                <span asp-validation-for="EmailAddress"
                      class="field-error">
                </span>

            </div>


            <!-- PASSWORD -->

            <div class="form-group">
                <label asp-for="Password">
                    Password
                </label>

                <div class="password-wrapper">
                    <input asp-for="Password"
                        id="loginPassword"
                        class="glass-input"
                        type="password"
                        placeholder="Enter your password"
                        autocomplete="current-password" />
                </div>

                <span asp-validation-for="Password"
                    class="field-error">
                </span>
            </div>

            <!-- REMEMBER ME -->

            <div class="form-options">

                <label class="remember-me">

                    <input asp-for="RememberMe"
                           type="checkbox" />

                    Remember me

                </label>

            </div>


            <!-- LOGIN BUTTON -->

            <button type="submit"
                    class="primary-button">

                Log In

            </button>

        </form>


        <!-- REGISTER LINK -->

        <p class="auth-footer">

            Don't have an account?

            <a asp-controller="Account"
               asp-action="Register">

                Register

            </a>

        </p>

    </div>

</div>


<script>
    document.addEventListener("DOMContentLoaded", function () {
        const toast = document.getElementById("successToast");

        if (toast) {
            setTimeout(() => {
                toast.classList.add("hide");
            }, 3000);

            setTimeout(() => {
                toast.remove();
            }, 3400);
        }
    });
</script>
