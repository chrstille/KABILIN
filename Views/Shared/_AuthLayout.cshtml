<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - KABILIN</title>

    <link rel="stylesheet"
      href="~/css/auth.css"
      asp-append-version="true" />
</head>

<body class="auth-body">

    <main class="auth-container">

        @RenderBody()

    </main>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>