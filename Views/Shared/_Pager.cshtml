@model IPaged
@{
    string Link(int page)
    {
        var parts = Context.Request.Query
            .Where(q => !string.Equals(q.Key, "page", StringComparison.OrdinalIgnoreCase))
            .SelectMany(q => q.Value.Select(v => $"{Uri.EscapeDataString(q.Key)}={Uri.EscapeDataString(v ?? "")}"))
            .ToList();
        parts.Add($"page={page}");
        return Context.Request.Path + "?" + string.Join("&", parts);
    }
    var start = Math.Max(1, Model.Page - 2);
    var end = Math.Min(Model.TotalPages, start + 4);
    start = Math.Max(1, end - 4);
}
@if (Model.Total > 0)
{
    <div class="pager">
        <span>Showing @Model.From-@Model.To of @Model.Total</span>
        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Pagination">
                @if (Model.Page > 1) { <a href="@Link(Model.Page - 1)" aria-label="Previous page">@Html.Icon("chevron-left", "icon-sm")</a> }
                else { <span class="page disabled">@Html.Icon("chevron-left", "icon-sm")</span> }
                @for (var i = start; i <= end; i++)
                {
                    if (i == Model.Page) { <span class="page current" aria-current="page">@i</span> }
                    else { <a href="@Link(i)">@i</a> }
                }
                @if (Model.Page < Model.TotalPages) { <a href="@Link(Model.Page + 1)" aria-label="Next page">@Html.Icon("chevron-right", "icon-sm")</a> }
                else { <span class="page disabled">@Html.Icon("chevron-right", "icon-sm")</span> }
            </nav>
        }
    </div>
}
