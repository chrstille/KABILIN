@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
    Layout = "_AuthLayout";
}
<div class="auth-card">
    <h1>Something went wrong</h1>
    <p class="lead">We could not complete that request. Please go back and try again.</p>
    @if (Model.ShowRequestId)
    {
        <p class="support mb-16">Reference: <code>@Model.RequestId</code></p>
    }
    <a class="btn btn-primary" asp-controller="Account" asp-action="Login">Back to KABILIN</a>
</div>
