<dialog class="dialog" id="confirmDialog" aria-labelledby="confirmTitle">
    <div class="dialog-body">
        <h3 id="confirmTitle" data-confirm-title>Please confirm</h3>
        <p class="muted" data-confirm-text></p>
    </div>
    <div class="dialog-actions">
        <button type="button" class="btn btn-secondary" data-confirm-cancel>Cancel</button>
        <button type="button" class="btn btn-danger-solid" data-confirm-ok>Confirm</button>
    </div>
</dialog>
